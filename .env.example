# Public frontend URL used to resolve Open Graph URLs; set before building previews/custom domains
NEXT_PUBLIC_SITE_URL=https://talenttrust-frontend.vercel.app

# Backend API base URL
NEXT_PUBLIC_API_URL=https://talenttrust-backend.vercel.app

# ── Stellar / Soroban ────────────────────────────────────────────────────────
# Network to connect to: "testnet" (default) | "mainnet" | "futurenet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed escrow contract address (C…)
# Legacy names NEXT_PUBLIC_CONTRACT_ID and NEXT_PUBLIC_ESCROW_CONTRACT_ID still
# work as fallbacks but NEXT_PUBLIC_STELLAR_CONTRACT_ID takes precedence.
NEXT_PUBLIC_STELLAR_CONTRACT_ID=CCZMIVUBMG5SBC47SDTC32RWLBJ2HW2DCFVWJEOKCH2IFJBZGBKTXK5W

# Soroban RPC endpoint (defaults to the public SDF endpoint for the chosen network)
# Legacy name NEXT_PUBLIC_SOROBAN_RPC_URL still works as a fallback.
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Override the network passphrase (rarely needed; computed from NEXT_PUBLIC_STELLAR_NETWORK if absent)
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
